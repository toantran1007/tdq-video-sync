{
  "name": "tdq-video-sync",
  "version": "1.3.0",
  "description": "Đồng bộ video hoặc hình ảnh theo timeline Voice hoặc SRT",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "vn.tdq.videosync",
    "productName": "TDQ Video Sync",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      }
    ],
    "win": {
      "icon": "src/assets/tdq-video-sync-icon.png",
      "executableName": "TDQ Video Sync",
      "target": [
        "portable"
      ],
      "artifactName": "TDQ-Video-Sync-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TDQ-Video-Sync-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TDQ-Video-Sync-${version}-Setup.${ext}"
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true,
    "electron@43.4.0": true
  }
}
